# Port the Express API listens on
PORT=4000

# development keeps the session cookie readable over plain HTTP, production requires HTTPS
NODE_ENV=development

# MongoDB connection string — mongodb://mongo:27017 under docker compose
MONGO_URI=mongodb://127.0.0.1:27017

# Database name inside that MongoDB instance
MONGO_DB=virallens

# Secret used to sign the HS256 session JWT — generate with: openssl rand -hex 32
JWT_SECRET=replace-with-a-long-random-string

# Origin allowed to send credentialed browser requests to the API
CORS_ORIGIN=http://localhost:5173

# OpenAI-compatible Bedrock gateway base URL — already ends in /v1, do not append another
BEDROCK_BASE_URL=https://bedrock-mantle.ap-south-1.api.aws/v1

# Bearer key for the gateway above — keep this out of git, never commit the real value
BEDROCK_API_KEY=replace-with-your-bedrock-api-key

# Model id used when the client does not pick one from the catalog
BEDROCK_MODEL=qwen.qwen3-32b

# Set true only when the app is served over HTTPS. Behind a plain-HTTP reverse proxy leave it
# false, otherwise the browser refuses to store the Secure session cookie and login silently fails
COOKIE_SECURE=false

# Interface the API binds to. 127.0.0.1 when nginx fronts it, so the port is not publicly reachable
HOST=0.0.0.0

# Number of proxy hops to trust for the client IP. 1 behind nginx, 0 when exposed directly —
# only safe to trust when the API binds to loopback and the proxy is the sole ingress
TRUST_PROXY=0
